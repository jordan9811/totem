# Totem — the PUBLIC deployment's environment, NAMES ONLY (BROWSER KEYSTORE PASS Gate 4).
# A public deployment is a production build WITHOUT the dev hooks. The app server holds no identity: the device is
# the visitor's browser. instrumentation.ts refuses to start if any must-not-ship variable is set; validator/server.js
# refuses the same way. Copy this file, fill in the few values that are yours, never commit the copy.

# ---- required
NODE_ENV=production
# the validator this app talks to (server side) and the one the browser device talks to (public)
VALIDATOR_URL=
NEXT_PUBLIC_VALIDATOR_URL=
# this app's own origin (used for WebAuthn origin checks and links)
APP_URL=
# the app server's one REQUIRED secret (the optional live-read key below is the second, FC-READ): derives the
# wrap-path release keys (D-CU-2-THE-WRAP-PATH-IS-STATELESS-ON-THE-SERVER).
# 32+ characters. Rotating it orphans every wrap-path passkey blob (A-CU-2-RELEASE-SECRET-ROTATION).
CUSTODY_RELEASE_SECRET=

# ---- required to be OFF (unset or empty). The boot check refuses to start otherwise.
ZK_DEV_HOOKS=
ENABLE_WRITE=
ENABLE_FC_WRITE=
ENABLE_X_WRITE=
ENABLE_X_READ=
FID_ACQUIRE_ENABLED=
DATA_SOURCE=
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=
NEYNAR_WALLET_ID=
FC_TEST_CUSTODY_PRIVATE_KEY=
FC_TEST_SIGNER_UUID=
X_LAYERS_INBOX_TOKEN=
# PERSONA LAUNCH P2 (Bring your X): a paid X developer app's credentials never ship (X sign-in is not built)
X_API_CLIENT_ID=
X_API_CLIENT_SECRET=
# CONNECT MAIN: the connector account (owner service only): its custody key and its fid never ship
# optional since the CONNECTOR SETUP pass: leave both unset and the owner service creates and seals the connector itself
# (scripts/owner/arm-connector.ps1); when set, these two win and a sealed connector refuses to be created
FC_CONNECT_APP_CUSTODY_KEY=
FC_CONNECT_APP_FID=
# FC-READ: an identity pointer, refused on a public deployment whatever fid it names (the owner service may set it)
NEYNAR_VIEWER_FID=
# PERSONA LAUNCH P6 (D6 / O1): the Totem registrar wallet's key — owner service only; nothing on a public process reads it
LAYERS_REGISTRAR_PRIVATE_KEY=
# PERSONA LAUNCH GO-LIVE: the owner-service-only live switches and credentials of the live X transport and the live
# registrar. PUBLIC GO-LIVE: both are PARKED (SECURITY-POSTURE §29/§30): nothing in this build reads them and no script
# sets them. Leave every one EMPTY: a public process that carries any of them refuses to boot (the public server stays
# keyless, and nothing on it may turn a live path on)
# the @totem X app's consumer key and secret, and the @totem account's access token and secret (live X outbox)
X_LAYERS_API_KEY=
X_LAYERS_API_SECRET=
X_LAYERS_ACCESS_TOKEN=
X_LAYERS_ACCESS_SECRET=
# the switches that send approved X copies (and replies) to the real X API
X_LIVE=
X_LIVE_REPLIES=
# the switch that lets the registrar submit real Bundler transactions, and its batch window
REGISTRAR_LIVE=
REGISTRAR_WINDOW=

# ---- optional
# the origins allowed to present WebAuthn assertions (comma separated); APP_URL is always allowed
CUSTODY_ALLOWED_ORIGINS=
# "true" behind a hosting edge (Railway: true on BOTH services, D-CU-6-TRUST-PROXY-ON-THE-PLATFORM). PERSONA LAUNCH GO-LIVE:
# the public VALIDATOR needs it — without it the edge's own headers (X-Real-IP, X-Forwarded-*, X-Request-Start,
# X-Railway-*) refuse EVERY anonymous submission a browser sends (validator/anon.js, fail closed). With it, both processes
# key their rate limits on the hop the edge vouches for (X-Real-IP, else the right-most X-Forwarded-For entry), never on a
# client-written left-most entry. Leave it empty only where no proxy sits in front: then both key on the socket address
# and ignore the headers (A-CU-5-TRUST-PROXY)
TRUST_PROXY=true
# never "allow" on a public deployment: the fixture provider is a rig adapter and the boot check refuses it
CUSTODY_FIXTURE_PROVIDER=
# DOCS UNDER APP: leave EMPTY. The app serves the docs itself at /docs (npm run build builds them), and the landing's
# docs door, Help's docs link and the banner's "what this means" link go there. A value OVERRIDES /docs (only for a
# future custom docs domain): an old docs-service address left here would send every door to a retired service.
NEXT_PUBLIC_DOCS_URL=
# the kill switch: "true" serves a static maintenance page on every route but liveness, on a restart, no rebuild
LAYERS_MAINTENANCE=
# PUBLIC GO-LIVE: public live mode: the public site is the product (no demo world in any visitor's tab; the guided first run at /welcome)
# the public APP and the public VALIDATOR; "true", "false" or unset; anything else refuses boot
PUBLIC_LIVE=true
# VALIDATOR_X_INDEX=on       # optional, the public VALIDATOR: builds the keyless list of Farcaster-verified X accounts nightly (the guided first run's X step reads it whole); off = the step says it couldn't check
# ---- optional, APP SERVICE ONLY: live Farcaster reads (FC-READ, lib/fc/readRelay.server.ts). Leave the key empty and
# nothing changes. Set it as a SERVICE variable on the app — never a shared/project variable: the validator refuses to
# start with it. It is the app server's second secret: a key from a SEPARATE Neynar app with no signers, no wallet and
# no webhooks. The relay never exits the process — a bad value disarms it with a named reason in the log instead.
# 16-80 characters of letters, digits and dashes; rotating or deleting it at dev.neynar.com is the only kill switch
# for a LEAKED key (A-FCREAD-KEY-IS-UNSCOPED)
NEYNAR_READ_API_KEY=
# "off" pauses live reads without deleting the key (open tabs keep their cached posts, labelled stale)
FC_READ=
# credits the relay may spend per UTC day on cache misses, per instance (default 100000; resets on every redeploy)
FC_READ_DAILY_CREDITS=
# FC-READ: where the live For You / Explore authors come from — set EXACTLY ONE of the next two (both, neither, or a
# malformed value keeps the relay off with "bad_config", naming the variable in the log, never its value). There is
# no default: whose posts appear under the Totem name is the owner's call. Channels are not a v1 emphasis
# (FC_READ_CHANNELS is no longer read). A change to either variable takes effect on the next restart or redeploy.
# (1) FC-READ (no channels): the discovery AUTHORS, comma separated Farcaster fids, 1 to 100 — the mix is these
# accounts' own top-level casts; changing it is a redeploy
FC_READ_FIDS=
# (2) FC-READ (house): ONE fid, a dedicated "house" Farcaster account whose FOLLOWS are the discovery authors — curate
# by following and unfollowing in any Farcaster client, no redeploy, no 100 cap (a follow shows within about a quarter
# of an hour: the relay caches discovery 600 s, an open tab refreshes every 2 minutes, and Neynar must index the
# follow first). Its follow list is public on Farcaster, and whoever controls that account (or
# any app signed into it) curates this feed; never the owner's personal account (D-FCREAD-HOUSE-ACCOUNT)
FC_READ_HOUSE_FID=
# hide authors whose Neynar user score is below this (default 0.5; an author with no score is hidden)
FC_READ_MIN_SCORE=
# the operator denylist: comma separated fids and 0x cast hashes, never shown
FC_READ_DENY=
# ---- optional, VALIDATOR ONLY: THE PUBLIC @anon RELAY (PUBLIC GO-LIVE, validator/anonpublic.js). Persona posts reach
# Farcaster through ONE account: the anon agent made with "Create Agent" in a Neynar app that holds NOTHING else (not the
# personas' app, not the read key's app). Set ONLY on the validator, ONLY by scripts/owner/arm-public-anon.ps1 (hidden
# prompts, the key on stdin, never in a command line). The public APP refuses to boot with the signer or the key
# (lib/platform/env-contract.ts APP_ONLY_REFUSES): the app server stays keyless. Leave all of these empty and nothing posts.
# the agent's account number (public), its signer (secret), and the agent-only app's key (secret)
FC_ANON_FID=
FC_ANON_SIGNER_UUID=
FC_ANON_NEYNAR_KEY=
# the relay's switch: "on" arms it. Deleting it is the kill switch (arm-public-anon.ps1 -Disarm deletes it ALONE): nothing new
# is posted and posts still waiting for their slot are dropped, while a moderator's removal still deletes from Farcaster
# with the key above. -Disarm -RevokeKey (a leaked key) also deletes the key and the signer; removals then wait for a key.
ZK_ANON_RELAY_LIVE=
# the LIFETIME cap on posts the relay ever accepts — REQUIRED on this path (arm-public-anon.ps1 sets it, default 20;
# -RaiseCap raises it). The daily cap ZK_ANON_POST_DAILY_CAP (default 500) and K=4 per person per 6 hours apply too
ZK_ANON_POST_LIVE_CAP=
# the moderators who work the takedown queue: comma separated Ed25519 PUBLIC keys (Settings > Moderation shows a device's)
ANON_MODERATORS=
# optional: extra scam domains the text filter refuses (comma separated host names; the built-in rule always runs)
ANON_FILTER_SCAM_DOMAINS=
# optional: the keyless Optimism RPC the Farcaster gate reads (https only; default https://mainnet.optimism.io) — and the
# gate needs APP_URL on the validator too (a sign-in's domain must be this site's)
ANON_FID_RPC_URL=
# THE HUB ROUTE (no Neynar): "hub" posts with the @anon account's OWN signer key straight to a Farcaster hub; empty = neynar.
# The account is made once by scripts/owner/make-anon-account.ps1; arm-public-anon.ps1 -Transport hub sets these (key on stdin).
# FC_ANON_SIGNER_KEY is the secret (validator only; the app refuses it); FC_HUB_URL a Snapchain node, e.g. https://snap.farcaster.xyz:3381
ZK_ANON_TRANSPORT=
FC_ANON_SIGNER_KEY=
FC_HUB_URL=
# note (PUBLIC GO-LIVE, ASM-1): with the Farcaster gate on (every public validator) a LIVE anonymous post proves the
# Farcaster-joined crowd (ZK_ANON_POST_TREE=valid) and nothing else: ZK_ANON_REACH_ISSUERS applies to the test universe only,
# and the reach issuer ids cannot be registered in the live universe here
# ---- optional, APP ONLY: the anonymous universe the app hands every visitor's tab. "live" (set by arm-public-anon.ps1 once
# the relay is armed) makes every tab prove in the live universe and register in it at boot; posting is on only while the
# validator ALSO says its relay is armed. Empty = the test universe (preview-only posts, labelled so)
ZK_ANON_UNIVERSE=
# the app's BUILD: "1" makes npm run build FAIL unless the pinned proving files ship with it (scripts/build-device.mjs)
REQUIRE_ZK_ARTIFACTS=
# the app's BUILD: "1" fetches a missing pinned proving file from the pinned host first (lib/zk/ceremonyPins.ts
# SEMAPHORE_ARTIFACT_BASE) and keeps it only if it matches its pins — the files are gitignored, so an upload never carries them.
# Build-time only: set it (and REQUIRE_ZK_ARTIFACTS=1) BEFORE the deploy that builds; a redeploy does not rebuild
ZK_ARTIFACT_FETCH=
# PUBLIC GO-LIVE (anonpage) — the Farcaster Mini App's account association: PUBLIC values, not secrets (a signature over
# {"domain": "<this site's host>"} by the Farcaster account that owns the "Anon Wire" Mini App). Set ONLY on the public
# APP (never the validator) by scripts/owner/arm-miniapp.ps1, after signing in the Farcaster manifest tool
# (https://farcaster.xyz/~/developers/new) for the EXACT final domain. Unset: /.well-known/farcaster.json is served
# unsigned (the server logs why) and Farcaster refuses the Mini App.
MINIAPP_ACCOUNT_ASSOCIATION_HEADER=
MINIAPP_ACCOUNT_ASSOCIATION_PAYLOAD=
MINIAPP_ACCOUNT_ASSOCIATION_SIGNATURE=
# SIGN IN WITH X — the X developer app's OAuth 2.0 client id: a PUBLIC value (it rides every authorize link). Set on BOTH
# the public app (it hands the tab the hint) and the public validator (its stateless relay forwards only this id), by
# scripts/owner/arm-x-signin.ps1. Unset: Continue with X says Soon. X_SIGNIN=off on either is the kill switch.
# X_CLIENT_SECRET only for a confidential X app ("Web App"), on the VALIDATOR ONLY (the public app refuses it at boot).
X_CLIENT_ID=
# X_CLIENT_SECRET=   (validator only, confidential X apps only)
# ---- validator only: abuse caps (defaults 100 per address per day, 2000 per device per hour) and backups
VALIDATOR_NEW_ROOTS_PER_ADDRESS_PER_DAY=
VALIDATOR_WRITES_PER_DEVICE_PER_HOUR=
# the volume's paths; with no backup directory the schedule does not run
VALIDATOR_DB=
VALIDATOR_DEATHS_LOG=
VALIDATOR_BACKUP_DIR=
VALIDATOR_BACKUP_EVERY_MS=
VALIDATOR_BACKUP_KEEP=
# the custody provider adapter: "fixture" is the only one in the tree (A-CU-2-REAL-PROVIDER-NOT-EXERCISED)
CUSTODY_PROVIDER=fixture
# zk mode for the preview
ZK_MODE=fixture
# PERSONA LAUNCH GO-LIVE (D-PUBLIC-ANON-TREE): the crowd a stranger's anonymous post proves it comes from — the PUBLIC
# DEFAULT is "valid" (every registered browser root; a fresh visitor joins it and can post from the next 6-hour window).
# Set the SAME value on the app (it forwards it to every visitor's tab) and the validator (it accepts only that tree): a
# mismatch turns anonymous posting off on the site, in plain words, and smoke-deployed check 10 fails. Unset, both fall
# back to tier-<ZK_GATE_TIER>, which a fresh root never reaches (every stranger refused). Posts stay preview-only either way.
ZK_ANON_POST_TREE=valid
# the validator: signed envelopes required; origins allowed to reach it are the app's
LAYERS_REQUIRE_SIG=true
LAYERS_APP_PORT=3001
LAYERS_VALIDATOR_PORT=4001
