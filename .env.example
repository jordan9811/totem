# Environment variables this project reads (NAMES only — copy to .env.local and fill in).
# Never commit .env.local. Live Farcaster/Neynar credentials never go to a public demo.
NEYNAR_API_KEY=
NEYNAR_WALLET_ID=
VALIDATOR_URL=
NEXT_PUBLIC_VALIDATOR_URL=
FC_TEST_FID=
FC_TEST_FNAME=
FC_TEST_ORIGIN=
FC_TEST_CUSTODY_ADDRESS=
FC_TEST_CUSTODY_PRIVATE_KEY=
FC_TEST_SIGNER_UUID=
FC_TEST_SIGNER_PUBLIC_KEY=
# Attestation pass Gate 0 — PORT PINNING. Totem runs on explicit ports; the
# defaults are 3001 (app) and 4001 (validator), never 3000/4000. BASE_URL /
# VALIDATOR_URL still override the peer URLs when set.
LAYERS_APP_PORT=
LAYERS_VALIDATOR_PORT=

# MULTI-FID PASS Gate 0 — attestation knobs (all optional)
# ATTEST_PROTOCOLS=aave,morpho,compound,uniswap   # the onchain protocol-history set (Aerodrome is out by default)
# ATTEST_DEMO_WALLET_SEED=layers-chain-wallet/0   # the seeded wallet the FIXTURE chain-facts issuer binds on demand
# ATTEST_WEBPROOF_SOURCE=fixture                  # x.* issuers: fixture | live (live is a refusal until a verifier exists)
# ATTEST_FID_SOURCE=fixture                       # neynar.* issuers: fixture | live (Neynar API, read-only)
# ONBOARDING_GATE=[{"issuer":"x.account-age","buckets":["gte-2y-stable"]}]   # the OR-gate disjunction (JSON)

# MULTI-FID PASS Gate 1 — persona network identities
# PERSONA_NETWORK_MODE=per-persona-fid   # per-persona-fid (default) | shared-fid (the Pass-FC v0, kept for anon-post mode)
# FC_SIGNER_CUSTODY=neynar-managed       # neynar-managed (default) | self-custody (fixture + spec; live is Call Option A)
# FID_SPEND_CAP_USD=10                   # hard cap for real spend on persona fids (the whole pass)
# FID_CREATE_USD_ESTIMATE=0.90           # the cost sheet's per-registration estimate (REPORT-FC measured $0.35–$0.90)

# MULTI-FID PASS Gate 3
# PERSONA_FID_LIVE_ONLY=false   # true: a fork never mints a fixture fid; the new persona waits for the user's live acquisition

# MULTI-FID PASS Gate 4 — anon-post mode (both processes read these; the validator enforces its own copy)
# ZK_ANON_POST_TREE=tier-2            # the predicate an anon post proves: the discovery gate tree, or attest:<issuer>/<bucket>
# ZK_ANON_POST_WINDOW_EPOCHS=1        # one anon post per root per window of this many epochs
# ZK_ANON_POST_MAX_CHARS=320
# --- validator only: the shared anon account it relays through (its OWN throwaway; never a persona's signer)
# FC_ANON_FID=                        # defaults to FC_TEST_FID
# FC_ANON_SIGNER_UUID=                # the throwaway's managed signer (validator env; never the app's)
# ZK_ANON_POST_LIVE_CAP=1             # live relays the validator will ever make (this pass: one)

# MULTI-FID PASS Gate 5 — after the adversarial reviews
# FID_ACQUIRE_ENABLED=false     # true on the APP only while running npm run fid:acquire — arms recordLiveFid / live spend entries (apart from the rig flag)
# --- validator only (the anon relay is a real write): ---
# ENABLE_FC_WRITE=false         # the validator's own arming flag for live relays (in addition to FC_ANON_FID / FC_ANON_SIGNER_UUID / NEYNAR_API_KEY)
# FC_ANON_FID=                  # REQUIRED for a live relay; no default (never the app's throwaway by accident)
# ZK_ANON_RELAY_INTERVAL_MS=3600000   # pending live anon rows are relayed at the top of each interval, in random order (store-and-forward)

# PERSONA LAUNCH P1 — Sign in with Farcaster (the public site's browser device verifies; the server holds nothing new)
# FC_SIWF=on                            # off hides the card; the device sees on / off / fixture / owner / bad_config
# FC_SIWF_RELAY_URL=                    # default https://relay.farcaster.xyz; only loopback is honoured otherwise
# FC_SIWF_RPC_URL=                      # default https://mainnet.optimism.io; a bare https origin or loopback only (no keyed URL)

# PERSONA LAUNCH P2 — Bring your X v1 (no X API; the browser reads the archive)
# X_IMPORT_MAX_POSTS=20000
# X_IMPORT_MAX_FOLLOWS=10000
# X_IMPORT_MAX_LIKES=500                # the likes lane is off by default
# X_INDEX_MAX_AGE_MS=86400000           # how old a downloaded index may get before the device fetches it again
# --- validator only: the keyless list of Farcaster-verified X accounts
# VALIDATOR_X_INDEX=off                 # on: build it 60 s after boot, then nightly (reads api.farcaster.xyz, a beta endpoint)
# VALIDATOR_X_INDEX_EVERY_MS=86400000
# VALIDATOR_X_INDEX_DIR=                # default <db dir>/x-index
# VALIDATOR_X_INDEX_FNAME_PAGES_PER_RUN=1500
# X_API_CLIENT_ID / X_API_CLIENT_SECRET are MUST_NOT_SHIP: a public deployment refuses to boot with either set

# PERSONA LAUNCH P3 — persona-scoped anon posting (K posts per person per window, shared across personas)
# ZK_ANON_POST_SLOTS=4                  # BOTH processes, identical (1..16; blank = unset); a mismatch pauses anon posting
# --- validator only
# ZK_ANON_POST_DAILY_CAP=500            # every anon post accepted in a day, for everyone
# ZK_ANON_RELAY_SPREAD_MS=              # default by shape: public 1800000, rig and owner service 0
# (ZK_ANON_RELAY_INTERVAL_MS defaults by shape too: public 1800000, rig and owner service 3600000.
#  ZK_ANON_POST_LIVE_CAP defaults to 1 on every non-public shape even when unset or blank; on the public shape it applies only when set.)

# PUBLIC GO-LIVE (2026-10-17) — the public site is the product (notes/runbooks/GO-LIVE-TODAY.md). Railway variables on the PUBLIC services;
# none of these belongs in .env.local, and no key is ever written in a file.
# --- both public services (app AND validator)
# PUBLIC_LIVE=true                     # live mode: no demo people, posts, trends, curators or desks. "true", "false" or unset;
#                                      # any other value refuses boot. Ignored (a warning) on the rig and the owner service
# TRUST_PROXY=true                     # behind Railway's edge; without it the validator refuses every browser anonymous post
# ZK_ANON_POST_TREE=valid              # D-PUBLIC-ANON-TREE: the crowd strangers prove, the SAME value on both
# APP_URL=https://<your domain>        # the app: the passkey RP id and origin, the Mini App manifest's address. The validator:
#                                      # the domain a Farcaster sign-in must name to join the live crowd (the fid gate)
# --- the public app only
# MINIAPP_ACCOUNT_ASSOCIATION_HEADER=  # the Farcaster Mini App's signed account association (PUBLIC values; set by
# MINIAPP_ACCOUNT_ASSOCIATION_PAYLOAD= #   scripts/owner/arm-miniapp.ps1); unset, /.well-known/farcaster.json is served unsigned
# MINIAPP_ACCOUNT_ASSOCIATION_SIGNATURE=
# ZK_ANON_UNIVERSE=live                # set by scripts/owner/arm-public-anon.ps1 once the validator's relay is armed: every tab
#                                      # proves in the live universe (live only while the validator also says its relay is live)
# (the app REFUSES FC_ANON_SIGNER_UUID and FC_ANON_NEYNAR_KEY: the app server stays keyless)
# REQUIRE_ZK_ARTIFACTS=1               # the app's BUILD fails without the pinned proving files (ZK_ARTIFACT_FETCH=1 fetches them first)
# --- the public validator only: the ONE relay credential (scripts/owner/arm-public-anon.ps1 sets these; keys on stdin only)
# FC_ANON_FID=                         # the public @anon agent's fid
# FC_ANON_SIGNER_UUID=                 # its Neynar signer uuid
# FC_ANON_NEYNAR_KEY=                  # the key of a Neynar app that holds NOTHING else (refused beside NEYNAR_API_KEY)
# ZK_ANON_RELAY_LIVE=on                # the relay's own switch
# ZK_ANON_POST_LIVE_CAP=               # REQUIRED on this path: the lifetime number of relayed posts (the script's -RaiseCap raises it)
# ANON_MODERATORS=                     # comma-separated Ed25519 PUBLIC keys (Settings › Moderation shows yours)
# ANON_FILTER_SCAM_DOMAINS=            # extra scam hosts the text filter refuses, comma separated (the built-in rule always runs)
# ANON_FID_RPC_URL=                    # the Optimism node the fid gate reads (https; default a public node)
# ZK_ANON_TRANSPORT=neynar             # "hub" (FC_HUB_URL) is named, not built: the relay stays off with it
# VALIDATOR_X_INDEX=on                 # the list of Farcaster-verified X accounts the guided start's X step looks up

# The names reserved for the PARKED live X transport and live registrar (2026-10-17) stay MUST_NOT_SHIP: X_LAYERS_API_KEY,
# X_LAYERS_API_SECRET, X_LAYERS_ACCESS_TOKEN, X_LAYERS_ACCESS_SECRET, X_LIVE, X_LIVE_REPLIES, REGISTRAR_LIVE, REGISTRAR_WINDOW.
# Nothing in the build reads them; a public process that carries one refuses to boot.
